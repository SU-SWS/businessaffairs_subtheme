<?php

/**
 * @file
 * Preprocess functions for Business Affairs Subtheme.
 */

/**
 * Prepares variables for the html.html.twig template.
 */
function businessaffairs_subtheme_preprocess_html(&$variables) {
  $variables['stanford_basic_path'] = \Drupal::service('extension.list.theme')->getPath('stanford_basic');
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function businessaffairs_subtheme_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  if (!empty($variables['elements']['#id']) && $variables['elements']['#id'] == 'businessaffairs_subtheme_search') {
    $suggestions[] = 'block__stanford_basic_search';
  }
}

/**
 * Implements hook_preprocess_HOOK() for ds_entity_view templates.
 *
 * Dispatches to per-bundle preprocess helpers so behavior setting classes
 * are applied to the correct paragraph wrapper element.
 */
function businessaffairs_subtheme_preprocess_ds_entity_view(&$variables) {
  if (!isset($variables['content']['#paragraph'])) {
    return;
  }

  $paragraph = $variables['content']['#paragraph'];

  if ($paragraph->bundle() == 'stanford_banner') {
    businessaffairs_subtheme_preprocess_banner($variables);
  }

  if ($paragraph->bundle() == 'stanford_page_title_banner') {
    businessaffairs_subtheme_preprocess_page_title_banner($variables);
  }
}

/**
 * Applies the selected banner style class to the banner paragraph wrapper.
 */
function businessaffairs_subtheme_preprocess_banner(&$variables) {
  $paragraph = $variables['content']['#paragraph'];
  $variables['attributes']['class'][] = $paragraph->getBehaviorSetting('react_paragraphs:banner_variant_info', 'banner_style');
}

/**
 * Applies the selected banner style class to the page title banner wrapper.
 */
function businessaffairs_subtheme_preprocess_page_title_banner(&$variables) {
  $paragraph = $variables['content']['#paragraph'];
  $variables['attributes']['class'][] = $paragraph->getBehaviorSetting('react_paragraphs:page_title_variant_info', 'banner_style');
}
